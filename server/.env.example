# Server Configuration
PORT=5000
NODE_ENV=development

# Client Origin (CORS & Cookie Auth)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/ecommerce_db

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production_32chars
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security Settings
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost
